# ORIGIN + path prefix of the candidate APIs (CrisprTechApp/crispr-apis).
# Leave unset to use production: https://crisprtech.app/crispr-apis
VITE_API_BASE=https://crisprtech.app/crispr-apis

# Optional. Base URL of the watch-history API (GET {url}/course/{courseId}?size=N, Bearer token).
# When unset, "Recently watched" on /courses uses the history kept in this browser.
# VITE_WATCH_HISTORY_URL=https://your.host/api/watch-history
